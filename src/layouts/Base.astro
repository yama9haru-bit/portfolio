---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Haruto Yamao - AI × Automation Engineer' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <h1 class="site-name">Haruto Yamao</h1>
        <p class="tagline">AI × Automation Engineer</p>
        <nav class="header-nav">
          <a href="/portfolio/">Home</a>
          <a href="/portfolio/about">About</a>
          <a href="/portfolio/services">Services</a>
          <a href="https://portfolio-site-beta-pink-87.vercel.app" target="_blank" rel="noopener noreferrer">Profile</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-links">
          <a href="https://portfolio-site-beta-pink-87.vercel.app" target="_blank" rel="noopener noreferrer">Profile / About the Author</a>
          <a href="https://github.com/yama9haru-bit" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="mailto:yama9haru@gmail.com">Email</a>
        </nav>
        <p>&copy; {new Date().getFullYear()} Haruto Yamao. All rights reserved.</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-border);
        padding-top: 0;
        padding-bottom: 0;
      }

      .header-inner {
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
      }

      .site-name {
        font-size: 1.8rem;
        color: var(--color-title);
        font-weight: 700;
      }

      .tagline {
        font-size: 1rem;
        color: var(--color-accent);
        font-weight: 500;
        margin-top: 0.25rem;
      }

      .header-nav {
        margin-top: 0.75rem;
        display: flex;
        gap: 1.5rem;
      }

      .header-nav a {
        font-size: 0.9rem;
        color: var(--color-muted);
        text-decoration: none;
        font-weight: 500;
      }

      .header-nav a:hover {
        color: var(--color-accent);
        text-decoration: underline;
      }

      .site-footer {
        border-top: 1px solid var(--color-border);
        padding-top: 0;
        padding-bottom: 0;
      }

      .site-footer .container {
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-bottom: 0.75rem;
      }

      .footer-links a {
        font-size: 0.85rem;
        color: var(--color-muted);
        text-decoration: none;
        font-weight: 500;
      }

      .footer-links a:hover {
        color: var(--color-accent);
        text-decoration: underline;
      }

      .site-footer p {
        font-size: 0.85rem;
        color: var(--color-muted);
        text-align: center;
      }
    </style>
  </body>
</html>