---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="card-header">
    <span class="card-id">{project.id}</span>
    <h3 class="card-title">{project.title}</h3>
  </div>
  <p class="card-description">{project.description}</p>
  <p class="card-client-value">
    <span class="label">提供価値</span>
    {project.clientValue}
  </p>
  {project.outcome && <p class="card-outcome"><span class="label">成果</span>{project.outcome}</p>}
  <ul class="card-highlights">
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>
  <div class="card-techstack">
    {project.techStack.map((t) => <span class="tech-badge">{t}</span>)}
  </div>
  <p class="card-date">{project.date}</p>
</article>

<style>
  .project-card {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 1.5rem;
    background: #fff;
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: var(--color-accent, #1b5faa);
  }

  .card-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-id {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent, #1b5faa);
    background: rgba(27, 95, 170, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .card-title {
    font-size: 1.1rem;
    color: var(--color-title, #1a1a1a);
    font-weight: 700;
    line-height: 1.4;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--color-body, #444);
    margin-bottom: 0.75rem;
  }

  .card-client-value {
    font-size: 0.9rem;
    color: var(--color-muted, #666);
    margin-bottom: 0.5rem;
  }

  .card-outcome {
    font-size: 0.9rem;
    color: var(--color-accent, #1b5faa);
    margin-bottom: 0.5rem;
  }

  .label {
    font-weight: 500;
    margin-right: 0.4rem;
  }

  .card-highlights {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }

  .card-highlights li {
    font-size: 0.9rem;
    color: var(--color-body, #444);
    margin-bottom: 0.25rem;
  }

  .card-techstack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0;
  }

  .tech-badge {
    font-size: 0.8rem;
    color: var(--color-muted, #666);
    background: #f4f4f4;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
  }

  .card-date {
    font-size: 0.8rem;
    color: var(--color-muted, #666);
    margin-top: 0.5rem;
  }
</style>