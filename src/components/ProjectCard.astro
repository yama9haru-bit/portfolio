---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailUrl = `/portfolio/projects/${project.slug}`;
---

<a href={detailUrl} class="card-link">
  <article class="project-card">
    <h3 class="card-title">{project.id} — {project.title}</h3>
    <p class="card-description">{project.description}</p>
    <p class="card-client-value">
      <span class="label">提供価値:</span>
      {project.clientValue}
    </p>
    {project.outcome && (
      <p class="card-outcome"><span class="label">成果:</span>{project.outcome}</p>
    )}
    <ul class="card-highlights">
      {project.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <p class="card-techstack">
      {project.techStack.map((t) => <span class="tech-item">{t}</span>)}
    </p>
    <p class="card-date">{project.date}</p>
  </article>
</a>

<style>
  .card-link {
    text-decoration: none;
    display: block;
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1.5rem;
    background: var(--color-bg);
  }

  .project-card:hover {
    border-color: var(--color-accent);
  }

  .card-title {
    font-size: 1.1rem;
    color: var(--color-title);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--color-body);
    margin-bottom: 0.75rem;
  }

  .card-client-value {
    font-size: 0.9rem;
    color: var(--color-body);
    margin-bottom: 0.5rem;
  }

  .card-outcome {
    font-size: 0.9rem;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .label {
    font-weight: 500;
    margin-right: 0.4rem;
    color: var(--color-muted);
  }

  .card-highlights {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0.75rem 0;
  }

  .card-highlights li {
    font-size: 0.9rem;
    color: var(--color-body);
    margin-bottom: 0.25rem;
  }

  .card-techstack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0;
  }

  .tech-item {
    font-size: 0.8rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .card-date {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
  }
</style>