---
import type { Project } from '../data/projects';
import TierBadge from './TierBadge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailUrl = `/portfolio/projects/${project.slug}`;
const accented = project.tier === 'S' || project.tier === 'A';
---

<a href={detailUrl} class="card-link">
  <article class={`project-card ${accented ? 'is-accented' : ''}`}>
    <div class="card-head">
      <h3 class="card-title">{project.id} — {project.title}</h3>
      <TierBadge tier={project.tier} />
    </div>
    <p class="card-description">{project.description}</p>
    <p class="card-client-value">
      <span class="label">提供価値:</span>
      {project.clientValue}
    </p>
    {project.outcome && (
      <p class="card-outcome"><span class="label">成果:</span>{project.outcome}</p>
    )}
    <ul class="card-highlights">
      {project.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <p class="card-techstack">
      {project.techStack.map((t) => <span class="tech-item">{t}</span>)}
    </p>
    <p class="card-date">{project.date}</p>
  </article>
</a>

<style>
  .card-link {
    text-decoration: none;
    display: block;
  }

  .card-link:hover {
    text-decoration: none;
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .project-card.is-accented {
    border-left: 3px solid var(--color-accent);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .card-title {
    font-size: var(--text-lg);
    color: var(--color-title);
    font-weight: 700;
    line-height: 1.4;
  }

  .card-description {
    font-size: 0.95rem;
    color: var(--color-body);
    margin-bottom: var(--space-3);
  }

  .card-client-value {
    font-size: 0.9rem;
    color: var(--color-body);
    margin-bottom: var(--space-2);
  }

  .card-outcome {
    font-size: 0.9rem;
    color: var(--color-accent-strong);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .is-accented .card-outcome {
    display: inline-block;
    background: var(--color-accent-soft);
    border-radius: var(--radius-sm);
    padding: 0.1rem var(--space-2);
  }

  .label {
    font-weight: 500;
    margin-right: 0.4rem;
    color: var(--color-muted);
  }

  .card-highlights {
    list-style: disc;
    padding-left: 1.5rem;
    margin: var(--space-3) 0;
  }

  .card-highlights li {
    font-size: 0.9rem;
    color: var(--color-body);
    margin-bottom: var(--space-1);
  }

  .card-techstack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-3) 0;
  }

  .tech-item {
    font-size: var(--text-xs);
    color: var(--color-muted);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  .card-date {
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: var(--space-2);
  }
</style>
