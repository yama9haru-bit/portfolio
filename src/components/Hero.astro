---
import StatTile from './StatTile.astro';
import { heroCopy, heroStats, type HeroStat } from '../data/stats';

interface Props {
  projectCount: number;
}

const { projectCount } = Astro.props;

const stats: HeroStat[] = [
  heroStats[0],
  { value: String(projectCount), label: '公開制作物' },
  heroStats[1],
];
---

<section class="hero-dark hero">
  <div class="hero-inner">
    <p class="hero-eyebrow">{heroCopy.eyebrow}</p>
    <h2 class="hero-catch">{heroCopy.catch}</h2>
    <p class="hero-sub">{heroCopy.sub}</p>
    <div class="hero-stats">
      {stats.map((s) => <StatTile value={s.value} suffix={s.suffix} label={s.label} />)}
    </div>
    <a class="hero-cta" href="#selected-works">実績を見る ↓</a>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    background-image: radial-gradient(
      ellipse 90% 70% at 50% -10%,
      rgba(91, 155, 216, 0.16),
      transparent 65%
    );
    border-bottom: 1px solid var(--color-border);
  }

  .hero-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-8) 1rem var(--space-7);
    text-align: center;
  }

  .hero-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .hero-catch {
    font-size: var(--text-4xl);
    color: var(--color-title);
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .hero-sub {
    font-size: var(--text-base);
    color: var(--color-body);
    max-width: 620px;
    margin: 0 auto var(--space-6);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .hero-cta {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-title);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-5);
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .hero-cta:hover {
    text-decoration: none;
    background: var(--color-accent);
    color: #0B0E14;
    transform: translateY(-1px);
  }
</style>
