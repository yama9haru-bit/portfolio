---
import { categories, categorySlugs } from '../data/categories';

interface Props {
  activeCategory?: string;
}

const { activeCategory } = Astro.props;
---

<nav class="category-nav">
  <ul>
    {categories.map((cat) => (
      <li>
        <a
          href={`/portfolio/category/${categorySlugs[cat]}`}
          class={activeCategory === cat ? 'active' : ''}
        >
          {cat}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .category-nav {
    margin-bottom: 2rem;
    overflow-x: auto;
  }

  .category-nav ul {
    display: flex;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .category-nav li {
    flex-shrink: 0;
  }

  .category-nav a {
    display: block;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .category-nav a:hover {
    color: var(--color-accent);
  }

  .category-nav a.active {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>