---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { projects } from '../data/projects';
import { categories } from '../data/categories';

const valueProps = [
  '業務自動化パイプライン設計・構築',
  'AIエージェントのプロダクト組み込み',
  '競合調査・市場分析によるDX戦略',
  'コンテンツ生成・配信の全自動化',
  'SaaS社内AI-DX（議事録インサイト抽出・リマインダーボット等）',
  'AI-native営業システム（企画立案→相談→受注まで運用中）',
];

const projectsByCategory = categories.map((cat) => ({
  category: cat,
  items: projects.filter((p) => p.category === cat),
}));
---

<Base>
  <section class="value-section">
    <h2>提供価値</h2>
    <ol class="value-list">
      {valueProps.map((v, i) => (
        <li>{v}</li>
      ))}
    </ol>
  </section>

  <CategoryNav />

  {projectsByCategory.map(({ category, items }) => (
    items.length > 0 && (
      <section class="category-section">
        <h2>{category}</h2>
        <div class="project-list">
          {items.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  ))}
</Base>

<style>
  .value-section {
    margin-bottom: 2.5rem;
  }

  .value-section h2 {
    margin-bottom: 1rem;
  }

  .value-list {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .value-list li {
    font-size: 1rem;
    color: var(--color-body);
    margin-bottom: 0.5rem;
  }

  .category-section {
    margin-bottom: 2.5rem;
  }

  .category-section h2 {
    margin-bottom: 1rem;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>