---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import { projects } from '../data/projects';
import { categories } from '../data/categories';

const valueProps = [
  '業務自動化パイプライン設計・構築',
  'AIエージェントのプロダクト組み込み',
  '競合調査・市場分析によるDX戦略',
  'コンテンツ生成・配信の全自動化',
  'SaaS社内AI-DX（議事録インサイト抽出・リマインダーボット等）',
  'AI-native営業システム（企画立案→相談→受注まで運用中）',
];

const participations = (await getCollection('participations')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const featured = projects.filter((p) => p.tier === 'S');

const projectsByCategory = categories.map((cat) => ({
  category: cat,
  items: projects.filter((p) => p.category === cat),
}));
---

<Base>
  <Hero slot="hero" projectCount={projects.length} />

  <section class="featured-section" id="selected-works">
    <p class="section-eyebrow">Selected Works</p>
    <h2 class="section-title">主要実績</h2>
    <div class="featured-grid">
      {featured.map((project) => <FeaturedCard project={project} />)}
    </div>
  </section>

  <section class="value-section">
    <h2>提供価値</h2>
    <ol class="value-list">
      {valueProps.map((v) => (
        <li>{v}</li>
      ))}
    </ol>
  </section>

  <CategoryNav />

  {projectsByCategory.map(({ category, items }) => (
    items.length > 0 && (
      <section class="category-section">
        <h2>{category}</h2>
        <div class="project-list">
          {items.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  ))}

  <section class="participation-section" id="participation" aria-labelledby="participation-title">
    <p class="section-eyebrow">Participation</p>
    <h2 class="section-title" id="participation-title">参加実績</h2>
    <div class="participation-grid">
      {participations.map((entry) => (
        <a class="participation-card" href={`/portfolio/participations/${entry.slug}/`}>
          <div class="participation-meta"><span>ハッカソン参加</span><span>{entry.data.period}</span></div>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.description}</p>
          <span class="participation-more">参加内容を見る →</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .participation-section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-7);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: var(--space-6);
  }
  .participation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .participation-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    color: var(--color-body);
    transition: border-color var(--transition-base);
  }
  .participation-card:hover { border-color: var(--color-accent); text-decoration: none; }
  .participation-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .participation-meta { display: flex; justify-content: space-between; gap: var(--space-3); font-size: var(--text-sm); color: var(--color-muted); }
  .participation-more { margin-top: auto; padding-top: var(--space-2); color: var(--color-accent); font-weight: 500; }
  @media (max-width: 640px) { .participation-grid { grid-template-columns: 1fr; } }

  .featured-section {
    margin-bottom: var(--space-7);
  }

  .section-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .section-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }

  .value-section {
    margin-bottom: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .value-section h2 {
    margin-bottom: var(--space-4);
  }

  .value-list {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .value-list li {
    font-size: var(--text-base);
    color: var(--color-body);
    margin-bottom: var(--space-2);
  }

  .category-section {
    margin-bottom: var(--space-6);
  }

  .category-section h2 {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
